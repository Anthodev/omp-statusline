{
  "name": "@anthodev/omp-statusline",
  "version": "0.1.0",
  "description": "Configurable statusline for Oh My Pi with context, usage, cost, VCS, Caveman, and Ponytail indicators.",
  "type": "module",
  "license": "MIT",
  "author": "Anthodev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anthodev/omp-statusline.git"
  },
  "homepage": "https://github.com/Anthodev/omp-statusline#readme",
  "bugs": "https://github.com/Anthodev/omp-statusline/issues",
  "keywords": [
    "omp-extension",
    "statusline",
    "jujutsu",
    "git"
  ],
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE",
    "omp-statusline.example.json"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
